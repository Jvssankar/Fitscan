# Copy this file to .env before running locally.
# NEVER commit .env to git.

# Flask secret key — any long random string
SECRET_KEY=change-me-to-something-random-and-long

# Anthropic API key — get one free at https://console.anthropic.com
# Required ONLY for the AI Interview feature. Everything else works without it.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Protects the /api/refresh endpoint
REFRESH_SECRET=fitscan-refresh-2024

# Leave blank for local SQLite. Render sets this automatically.
DATABASE_URL=
